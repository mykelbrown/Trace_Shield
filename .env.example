# =============================================================================
# Digital Footprint Intelligence (DFI) — environment configuration
#
# Copy this file to `.env` and fill in only the keys you have. Every provider
# degrades gracefully to a MOCK provider (clearly labeled in results and the
# research log) when its key is absent — the app never hard-fails because a
# credential is missing.
#
# NEVER commit your real .env file. It is already listed in .gitignore.
# =============================================================================

# ---- Storage --------------------------------------------------------------
# Path to the local SQLite database file (Node's built-in node:sqlite driver).
DFI_DB_PATH=./data/dfi.sqlite

# Optional passphrase used to encrypt sensitive fields at rest (AES-256-GCM).
# If unset, a random key is generated on first run and stored in data/.dfi.key
# (0600 permissions, gitignored). Set this explicitly for reproducible restores.
DFI_ENCRYPTION_KEY=

# Days to retain research-log entries before automatic pruning. 0 = keep forever.
DFI_LOG_RETENTION_DAYS=90

# ---- Search Engine Intelligence (Module A) ---------------------------------
# Brave Search API — https://brave.com/search/api/
# Free tier available. Used for name/email/phone/username/document queries.
BRAVE_SEARCH_API_KEY=

# Bing Web Search (optional alternate/secondary engine) — Azure Cognitive Services
BING_SEARCH_API_KEY=

# ---- Breach Intelligence (Module 12) ---------------------------------------
# Have I Been Pwned API — https://haveibeenpwned.com/API/Key
# Required for real breach lookups. Without it, DFI uses the bundled mock
# breach-notification provider and clearly labels results as MOCK DATA.
HIBP_API_KEY=

# ---- Code / Repository Exposure (Module 13) --------------------------------
# GitHub personal access token (read-only, no scopes needed for public search)
# https://github.com/settings/tokens — raises the unauthenticated rate limit
# from 10 req/min to 30 req/min (search API) and 60->5000 req/hr (core API).
GITHUB_TOKEN=

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Playwright/Chromium path for PDF report rendering (pre-installed in some
# environments). Leave unset to use the system-detected Chromium.
PLAYWRIGHT_BROWSERS_PATH=
